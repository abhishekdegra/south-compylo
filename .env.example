# Compylo Café — Environment Configuration
# Copy this file to .env or .env.local to customize environment values

# Public Website URL
VITE_SITE_URL="https://compylo.vercel.app"

# App Title & Meta
VITE_SITE_NAME="Compylo Café"
VITE_SITE_DESCRIPTION="Your neighborhood sanctuary for authentic Kumbakonam brass dabara filter kaapi, crispy ghee roast dosas, soft idlis, and cozy café vibes."

# Optional Third-Party Services (leave blank if not using)
# VITE_GOOGLE_ANALYTICS_ID=
# VITE_GOOGLE_MAPS_KEY=
